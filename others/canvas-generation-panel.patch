+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { getPopoverPosition } from './popoverPosition.js';
+
+test('opens above when there is room and clamps to the right viewport edge', () => {
+    const result = getPopoverPosition(
+        { top: 600, bottom: 638, left: 900 },
+        { width: 340, height: 300 },
+        { width: 1000, height: 800 },
+    );
+    assert.deepEqual(result, { left: 648, top: 288, width: 340, maxHeight: 576, placement: 'top' });
+});
+
+test('opens below a trigger near the top edge', () => {
+    const result = getPopoverPosition(
+        { top: 20, bottom: 58, left: 20 },
+        { width: 340, height: 300 },
+        { width: 1000, height: 800 },
+    );
+    assert.equal(result.placement, 'bottom');
+    assert.equal(result.top, 70);
+    assert.equal(result.maxHeight, 718);
+});
+
+test('oversized popup scrolls on the roomier side in a small viewport', () => {
+    const result = getPopoverPosition(
+        { top: 150, bottom: 188, left: 300 },
+        { width: 340, height: 600 },
+        { width: 320, height: 360 },
+    );
+    assert.deepEqual(result, { left: 12, top: 200, width: 296, maxHeight: 148, placement: 'bottom' });
+    assert.ok(result.top + result.maxHeight <= 348);
+});
+
+test('offscreen anchors never position the popup outside the viewport', () => {
+    for (const anchor of [
+        { top: -500, bottom: -462, left: -100 },
+        { top: 1500, bottom: 1538, left: 1200 },
+    ]) {
+        const result = getPopoverPosition(anchor, { width: 340, height: 300 }, { width: 800, height: 600 });
+        assert.ok(result.left >= 12 && result.left + result.width <= 788);
+        assert.ok(result.top >= 12 && result.top + Math.min(300, result.maxHeight) <= 588);
+    }
+});
