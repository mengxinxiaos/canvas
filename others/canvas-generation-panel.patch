+
+# Limits belong to the requested model, not to the shape of the UI. Keep the
+# legacy per-type limits for other models; Seedance 2.5 accepts 50 references
+# across image, video and audio inputs combined.
+SEEDANCE_25_MAX_REFERENCES = 50
+LEGACY_REFERENCE_LIMITS = {"image": 9, "video": 3, "audio": 3}
+
+
+def _reference_limit_error(model: str, image_count: int, video_count: int, audio_count: int):
+    counts = {"image": image_count, "video": video_count, "audio": audio_count}
+    if model == "doubao-seedance-2.5":
+        total = sum(counts.values())
+        if total > SEEDANCE_25_MAX_REFERENCES:
+            return f"Seedance 2.5 最多支持 {SEEDANCE_25_MAX_REFERENCES} 个引用资产，当前共 {total} 个。请减少引用后重试。"
+        return None
+
+    labels = {"image": "图片", "video": "视频", "audio": "音频"}
+    for media_type, limit in LEGACY_REFERENCE_LIMITS.items():
+        if counts[media_type] > limit:
+            return f"当前模型最多支持 {limit} 个{labels[media_type]}引用，当前为 {counts[media_type]} 个。请减少引用后重试。"
+    return None
+
+
 class ZhenZhenClient(BaseVideoClient):
