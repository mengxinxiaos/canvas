@@ -0,0 +1,51 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { labelReferenceMedia, reconcileReferenceOrder, remapReferencePrompt, reorderReferenceType, serializeReferenceMedia, restoreReferenceMedia, getReferenceValidationError } from './referenceMedia.js';
+
+const media = (id, type = 'image') => ({ id, type, src: `/${id}` });
+
+test('all reference aliases share numbering across UI and payload', () => {
+    const list = [media('a'), media('b', 'video_node'), media('c', 'audio'), media('d', 'video_media'), media('e', 'picture')];
+    assert.deepEqual(labelReferenceMedia(list).map(m => m.displayLabel), ['图1', '视1', '音1', '视2', '图2']);
+    assert.deepEqual(serializeReferenceMedia(list).map(m => m.type), ['image', 'video', 'audio', 'video', 'image']);
+});
+
+test('saved order survives reopen, duplicate edges, removal and reconnection', () => {
+    const list = [media('a'), media('b'), media('a'), media('v', 'video'), media('text', 'text')];
+    assert.deepEqual(reconcileReferenceOrder(list, ['b', 'missing', 'a']).map(m => m.id), ['b', 'a', 'v']);
+    assert.deepEqual(reconcileReferenceOrder([media('a'), media('b')], ['b']).map(m => m.id), ['b', 'a']);
+});
+
+test('deleting or externally disconnecting references preserves IDs in prompt', () => {
+    const previous = [media('a'), media('v', 'video'), media('b'), media('c')];
+    assert.equal(remapReferencePrompt('@图1 @图2 @图3 @视1', previous, [previous[1], previous[3], previous[2]]), ' @图2 @图1 @视1');
+});
+
+test('50 references remap full tokens without prefix collisions', () => {
+    const list = Array.from({ length: 50 }, (_, i) => media(String(i)));
+    const reversed = [...list].reverse();
+    assert.equal(remapReferencePrompt('@图1 @图10 @图50 @图99', list, reversed), '@图50 @图41 @图1 @图99');
+    assert.equal(serializeReferenceMedia(list).length, 50);
+});
+
+test('typed reorder leaves other media slots and numbering intact', () => {
+    const list = [media('a'), media('v', 'video'), media('b'), media('audio', 'audio')];
+    const next = reorderReferenceType(list, 'a', 'b');
+    assert.deepEqual(next.map(m => m.id), ['b', 'v', 'a', 'audio']);
+    assert.equal(reorderReferenceType(list, 'a', 'v'), list);
+});
+
+test('closed-panel disconnection remaps using the saved reference identity', () => {
+    const previous = [media('a'), media('b'), media('c')];
+    const generation = { inputs: serializeReferenceMedia(previous), referenceNodeIds: ['a', 'b', 'c'] };
+    const current = [media('b'), media('c')];
+    assert.equal(remapReferencePrompt('@图1 @图2 @图3', restoreReferenceMedia(generation, current), current), ' @图1 @图2');
+});
+
+test('submission validates missing URLs, incompatible media, combined limit and audio-only inputs', () => {
+    assert.match(getReferenceValidationError([{ id: 'a', type: 'image' }], 'video'), /尚未生成/);
+    assert.match(getReferenceValidationError([media('v', 'video')], 'image'), /仅支持图片参考/);
+    assert.match(getReferenceValidationError(Array.from({ length: 51 }, (_, index) => media(index)), 'video', { maxReferenceAssets: 50 }), /已连接 51/);
+    assert.match(getReferenceValidationError([media('a', 'audio')], 'video'), /画面参考/);
+    assert.equal(getReferenceValidationError([media('a', 'audio'), media('v', 'video')], 'video'), null);
+});
