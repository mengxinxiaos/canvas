+import { test, expect } from '@playwright/test';
+
+const fixture = '/tests/fixtures/generation-panel.html';
+const state = async page => JSON.parse(await page.getByTestId('saved-state').textContent());
+const submissions = async page => JSON.parse(await page.getByTestId('submissions').textContent());
+const panel = page => page.locator('[data-panel-for]');
+const editor = page => page.locator('.ProseMirror');
+
+test.beforeEach(async ({ page }) => {
+    page.runtimeErrors = [];
+    page.on('pageerror', error => page.runtimeErrors.push(error.message));
+});
+test.afterEach(async ({ page }) => {
+    expect(page.runtimeErrors).toEqual([]);
+});
+
+async function expectWithinViewport(locator, page) {
+    const box = await locator.boundingBox();
+    const viewport = page.viewportSize();
+    expect(box.x).toBeGreaterThanOrEqual(0);
+    expect(box.y).toBeGreaterThanOrEqual(0);
+    expect(box.x + box.width).toBeLessThanOrEqual(viewport.width);
+    expect(box.y + box.height).toBeLessThanOrEqual(viewport.height);
+}
+
+test('50 mixed assets have three regions, full saved inputs and reachable final asset', async ({ page }) => {
+    await page.goto(fixture);
+    await expect(page.getByRole('region', { name: '图片引用' })).toBeVisible();
+    await expect(page.getByRole('region', { name: '视频引用' })).toBeVisible();
+    await expect(page.getByRole('region', { name: '音频引用' })).toBeVisible();
+    await expect(page.locator('[data-reference-id]')).toHaveCount(50);
+    await page.getByRole('button', { name: '引用音5', exact: true }).scrollIntoViewIfNeeded();
+    await expect(page.getByRole('button', { name: '引用音5', exact: true })).toBeInViewport();
+    await expectWithinViewport(panel(page), page);
+    expect((await state(page)).generation.inputs).toHaveLength(50);
+    await page.screenshot({ path: 'test-results/generation-panel-50-assets.png' });
+});
+
+test('small viewport keeps panel and duration popup inside the window', async ({ page }) => {
+    await page.setViewportSize({ width: 360, height: 640 });
+    await page.goto(fixture);
+    await expectWithinViewport(panel(page), page);
+    await page.getByRole('button', { name: /720p/ }).click();
+    const popup = page.locator('[data-popover-placement]');
+    await expect(popup).toBeVisible();
+    await expectWithinViewport(popup, page);
+    await expect(page.getByRole('slider', { name: '生成时长' })).toBeVisible();
+    await page.screenshot({ path: 'test-results/generation-panel-mobile-duration.png' });
+});
+
+test('duration slider accepts 30s, auto and valid model switching', async ({ page }) => {
+    await page.goto(`${fixture}?count=0`);
+    await page.getByRole('button', { name: /720p/ }).click();
+    const slider = page.getByRole('slider', { name: '生成时长' });
+    await slider.focus();
+    await page.keyboard.press('Home');
+    await expect.poll(async () => (await state(page)).generation.duration).toBe('4');
+    await page.keyboard.press('End');
+    await expect.poll(async () => (await state(page)).generation.duration).toBe('30');
+    await page.getByRole('button', { name: '自动', exact: true }).click();
+    await expect.poll(async () => (await state(page)).generation.duration).toBe('-1');
+    await slider.focus();
+    await page.keyboard.press('End');
+    await page.keyboard.press('Escape');
+    await page.getByRole('button', { name: /即梦 2.5/ }).click();
+    await page.getByRole('button', { name: '即梦 2.0 (zhenzhen)', exact: true }).click();
+    await expect.poll(async () => (await state(page)).generation.duration).toBe('15');
+});
+
+test('external disconnect remaps mentions and reconnection shows removed asset again', async ({ page }) => {
+    await page.goto(`${fixture}?count=3&mixed=false&prompt=${encodeURIComponent('@图1 @图2 @图3')}`);
+    await expect(editor(page)).toContainText('图3');
+    await page.getByRole('button', { name: '外部断开第一项' }).click();
+    await expect.poll(async () => (await state(page)).generation.prompt).toBe(' @图1 @图2');
+    await expect(page.locator('[data-reference-id]')).toHaveCount(2);
+    await page.getByRole('button', { name: '重新连接第一项' }).click();
+    await expect(page.locator('[data-reference-id]')).toHaveCount(3);
+    await expect.poll(async () => (await state(page)).generation.referenceNodeIds).toEqual(['asset-1', 'asset-2', 'asset-0']);
+});
+
+test('disconnect while closed uses saved identities when reopening', async ({ page }) => {
+    await page.goto(`${fixture}?count=3&mixed=false&prompt=${encodeURIComponent('@图2')}`);
+    await expect(editor(page)).toContainText('图2');
+    await page.getByRole('button', { name: '关闭面板' }).click();
+    await page.getByRole('button', { name: '外部断开第一项' }).click();
+    await page.getByRole('button', { name: '打开面板' }).click();
+    await expect.poll(async () => (await state(page)).generation.prompt).toBe('@图1');
+    await expect(editor(page)).toContainText('图1');
+});
+
+test('keyboard sorting changes numbering while preserving referenced identity', async ({ page }) => {
+    await page.goto(`${fixture}?count=3&mixed=false&prompt=${encodeURIComponent('@图1')}`);
+    await page.getByRole('button', { name: '引用图1', exact: true }).focus();
+    await page.keyboard.press('Alt+ArrowRight');
+    await expect.poll(async () => (await state(page)).generation.referenceNodeIds).toEqual(['asset-1', 'asset-0', 'asset-2']);
+    await expect.poll(async () => (await state(page)).generation.prompt).toBe('@图2');
+    await editor(page).press('Control+z');
+    await expect.poll(async () => (await state(page)).generation.prompt).toBe('@图2');
+});
+
+test('drag drop commits its preview and cancelling a drag preserves saved order', async ({ page }) => {
+    await page.goto(`${fixture}?count=3&mixed=false&prompt=${encodeURIComponent('@图1')}`);
+    await page.locator('[data-reference-id="asset-0"]').dragTo(page.locator('[data-reference-id="asset-1"]'));
+    await expect.poll(async () => (await state(page)).generation.referenceNodeIds).toEqual(['asset-1', 'asset-0', 'asset-2']);
+    const transfer = await page.evaluateHandle(() => new DataTransfer());
+    await page.locator('[data-reference-id="asset-1"]').dispatchEvent('dragstart', { dataTransfer: transfer });
+    await page.locator('[data-reference-id="asset-2"]').dispatchEvent('dragover', { dataTransfer: transfer });
+    await page.locator('[data-reference-id="asset-1"]').dispatchEvent('dragend', { dataTransfer: transfer });
+    expect((await state(page)).generation.referenceNodeIds).toEqual(['asset-1', 'asset-0', 'asset-2']);
+    await page.locator('[data-reference-id="asset-1"]').dispatchEvent('dragstart', { dataTransfer: transfer });
+    await page.locator('[data-reference-id="asset-2"]').dispatchEvent('dragover', { dataTransfer: transfer });
+    await page.getByRole('button', { name: '外部更新时长' }).click();
+    await page.locator('[data-reference-id="asset-2"]').dispatchEvent('drop', { dataTransfer: transfer });
+    await expect.poll(async () => (await state(page)).generation.referenceNodeIds).toEqual(['asset-0', 'asset-2', 'asset-1']);
+    await transfer.dispose();
+});
+
+test('external text and reference order are adopted as a single snapshot', async ({ page }) => {
+    await page.goto(`${fixture}?count=3&mixed=false&prompt=${encodeURIComponent('@图1')}`);
+    await expect(editor(page)).toContainText('图1');
+    await page.getByRole('button', { name: '外部同时更新文本和顺序' }).click();
+    await expect.poll(async () => (await state(page)).generation.prompt).toBe('来自协作的新文字 @图3');
+    await expect(editor(page)).toContainText('来自协作的新文字');
+    expect((await state(page)).generation.referenceNodeIds).toEqual(['asset-2', 'asset-1', 'asset-0']);
+});
+
+test('typing then immediately submitting uses the latest prompt and blocks Enter while loading', async ({ page }) => {
+    await page.goto(`${fixture}?count=0&prompt=`);
+    await editor(page).fill('最新文本');
+    await editor(page).press('Enter');
+    await expect.poll(async () => (await submissions(page)).length).toBe(1);
+    expect((await submissions(page))[0].rawPrompt).toBe('最新文本');
+    await page.getByRole('button', { name: '模拟生成中' }).click();
+    await editor(page).press('Enter');
+    expect((await submissions(page)).length).toBe(1);
+});
+
+test('over-limit and unready inputs are visible and block submission', async ({ page }) => {
+    await page.goto(`${fixture}?count=51`);
+    await expect(page.getByRole('alert')).toContainText('最多支持 50');
+    await expect(page.getByRole('button', { name: '开始生成' })).toBeDisabled();
+    await page.goto(`${fixture}?count=3&mixed=false&unready=true`);
+    await expect(page.getByRole('alert')).toContainText('尚未生成或上传完成');
+    await editor(page).press('Enter');
+    expect(await submissions(page)).toHaveLength(0);
+});
+
+test('remote parameters hydrate the open panel and loaded prompt has no placeholder overlay', async ({ page }) => {
+    await page.goto(`${fixture}?count=0&prompt=${encodeURIComponent('已保存的内容')}`);
+    await expect(editor(page)).toHaveText('已保存的内容');
+    await expect(page.getByText('描述你想生成的视频内容 (输入 @ 引用资产)...', { exact: true })).toHaveCount(0);
+    await page.getByRole('button', { name: '外部更新时长' }).click();
+    await expect(page.getByRole('button', { name: /720p.*8s/ })).toBeVisible();
+});
