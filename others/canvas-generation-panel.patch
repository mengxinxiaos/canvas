+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createGenerationParams, normalizeGenerationParams, getManualDurations } from '../src/components/canvas/generation-panel/utils/generationParams.js';
+
+const SEEDANCE_25 = 'doubao-seedance-2.5';
+const SEEDANCE_20 = 'zhenzhen-doubao-seedance-2-0-260128';
+
+test('new and legacy video nodes always have a mode with selectable models', () => {
+    for (const generation of [{}, { model: SEEDANCE_25, videoRefMode: 'first_last' }]) {
+        const params = createGenerationParams(generation, 'video');
+        assert.equal(params.videoRefMode, 'multi_ref');
+        assert.equal(params.duration, '15');
+        assert.equal(params.aspectRatio, '16:9');
+    }
+});
+
+test('model changes reset incompatible values and preserve compatible ones', () => {
+    const original = createGenerationParams({ model: SEEDANCE_25, duration: '30', resolution: '1080p', aspectRatio: '9:16' }, 'video');
+    const next = normalizeGenerationParams({ ...original, videoModel: SEEDANCE_20 }, 'video');
+    assert.equal(next.duration, '15');
+    assert.equal(next.resolution, '1080p');
+    assert.equal(next.aspectRatio, '9:16');
+});
+
+test('saved values are normalized before rendering or sending', () => {
+    const params = createGenerationParams({ model: SEEDANCE_20, duration: 30, resolution: '4K', aspectRatio: 'invalid' }, 'video');
+    assert.equal(params.duration, '15');
+    assert.equal(params.resolution, '720p');
+    assert.equal(params.aspectRatio, '16:9');
+    const numeric = createGenerationParams({ model: SEEDANCE_25, duration: 30 }, 'video');
+    assert.equal(numeric.duration, '30');
+});
+
+test('automatic duration survives normalization and reference changes', () => {
+    const params = createGenerationParams({ model: SEEDANCE_25, duration: '-1' }, 'video', { inputPicturesCount: 50 });
+    assert.equal(params.duration, '-1');
+    assert.equal(params.videoRefMode, 'multi_ref');
+});
+
+test('unknown saved model and unsupported image settings recover to actual defaults', () => {
+    const params = createGenerationParams({ model: 'removed-model', imageSize: '8K', aspectRatio: 'bad' }, 'image');
+    assert.equal(params.imageModel, 'nano-banana-2');
+    assert.equal(params.imageSize, '2K');
+    assert.equal(params.aspectRatio, 'auto');
+});
+
+test('duration slider exposes only configured manual values, even for sparse models', () => {
+    assert.deepEqual(getManualDurations(['-1', '10', '5', '5', 15, 'NaN', '0']), ['5', '10', '15']);
+    assert.deepEqual(getManualDurations(['-1']), []);
+    assert.deepEqual(getManualDurations(), []);
+});
