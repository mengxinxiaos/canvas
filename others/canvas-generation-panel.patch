+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { getPanelLayout } from './panelLayout.js';
+
+const calculate = (overrides = {}) => getPanelLayout({
+    anchor: { left: 400, top: 100, width: 300, height: 100 },
+    viewportWidth: 1280, viewportHeight: 800, panelHeight: 300, ...overrides,
+});
+test('panel stays below node when it fits', () => assert.equal(calculate().top, 216));
+test('large asset region moves above a low node', () => {
+    const layout = calculate({ anchor: { left: 500, top: 650, width: 300, height: 100 }, panelHeight: 500 });
+    assert.equal(layout.top, 134);
+});
+test('small screens resize the panel and bound both axes', () => {
+    const layout = calculate({ viewportWidth: 360, viewportHeight: 480, panelHeight: 700 });
+    assert.deepEqual(layout, { width: 328, maxHeight: 448, left: 16, top: 16 });
+});
+test('offscreen nodes and viewport resizing never push the panel outside', () => {
+    for (const left of [-900, 3000]) {
+        const layout = calculate({ anchor: { left, top: -500, width: 300, height: 100 } });
+        assert.ok(layout.left >= 16 && layout.left + layout.width <= 1264);
+        assert.equal(layout.top, 16);
+    }
+});
