+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+    buildGenerationRequestInputs,
+    createGenerationSubmitter,
+    resolveGenerationInputs,
+} from './generationSubmission.js';
+
+function fixture(overrides = {}) {
+    const generator = { id: 'generator', type: 'image', generation: { imageStyle: 'ue' } };
+    const calls = [];
+    const updates = [];
+    const options = {
+        projectId: 'project',
+        shareToken: 'share-token',
+        genParams: {
+            nodeId: generator.id,
+            model: 'image-model',
+            prompt: 'expanded prompt',
+            rawPrompt: 'editable @图1',
+            inputs: [{ id: 'picture', type: 'image', url: '/picture.png' }],
+            gridMode: 'four_grid',
+            aspectRatio: '9:16',
+        },
+        canvasState: { nodes: [generator], edges: [] },
+        updateNodeStrictAndSave: (id, data) => updates.push({ id, data }),
+        pushHistory: () => {},
+        showToast: () => {},
+        ...overrides,
+    };
+    const service = createGenerationSubmitter({
+        taskService: {
+            createImageTask: async (payload, token) => {
+                calls.push({ payload, token });
+                return { taskId: 'task-image' };
+            },
+            createVideoTask: async (payload, token) => {
+                calls.push({ payload, token });
+                return { taskId: 'task-video' };
+            },
+        },
+        imageModels: [{ value: 'image-model', provider: 'image-provider' }],
+        videoModels: [{ value: 'video-model', provider: 'video-provider' }],
+    });
+    return { generator, options, service, calls, updates };
+}
+
+test('grid templates are request-only and never mutate or accumulate in saved inputs', async () => {
+    const { options, service, calls, updates } = fixture();
+    Object.freeze(options.genParams.inputs[0]);
+    Object.freeze(options.genParams.inputs);
+    await service.submitTask(options);
+    await service.submitTask(options);
+
+    assert.equal(options.genParams.inputs.length, 1);
+    assert.deepEqual(calls.map(call => call.payload.inputs.length), [2, 2]);
+    assert.equal(calls[0].payload.provider, 'image-provider');
+    assert.equal(calls[0].token, 'share-token');
+    assert.equal(updates[0].data.generation.inputs.length, 1);
+    assert.equal(updates[0].data.generation.prompt, 'editable @图1');
+    assert.equal(updates[0].data.generation.finalPrompt, 'expanded prompt');
+    assert.equal(updates[0].data.generation.imageStyle, 'ue');
+    assert.equal(calls[0].payload.prompt, 'expanded prompt');
+});
+
+test('explicit empty inputs do not resurrect connected assets', () => {
+    const { options, generator } = fixture();
+    const state = {
+        nodes: [generator, { id: 'picture', type: 'picture', src: '/picture.png' }],
+        edges: [{ from: 'picture', to: generator.id }],
+    };
+    assert.deepEqual(resolveGenerationInputs({ ...options.genParams, inputs: [] }, state, generator), []);
+});
+
+test('fallback preserves saved ordering, all media types, and only incoming edges', () => {
+    const generator = { id: 'generator', generation: { referenceNodeIds: ['audio', 'video', 'picture', 'disconnected'] } };
