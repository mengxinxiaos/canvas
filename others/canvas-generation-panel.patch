@@ -0,0 +1,62 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { Schema } from '@tiptap/pm/model';
+import { EditorState } from '@tiptap/pm/state';
+import { syncReferenceMentions } from './mentionDocument.js';
+
+const schema = new Schema({
+    nodes: {
+        doc: { content: 'paragraph+' },
+        paragraph: { content: 'inline*', group: 'block' },
+        text: { group: 'inline' },
+        mention: {
+            inline: true,
+            group: 'inline',
+            atom: true,
+            attrs: { id: {}, label: {}, src: {}, mediaType: {} },
+        },
+    },
+});
+const asset = (id, type = 'picture') => ({ id, type, src: `${id}.png` });
+const mention = (id, label, type = 'picture') => schema.node('mention', {
+    id, label, src: `${id}.png`, mediaType: type,
+});
+const state = (...children) => EditorState.create({
+    schema,
+    doc: schema.node('doc', null, [schema.node('paragraph', null, children)]),
+});
+const paragraphChildren = transaction => transaction.doc.firstChild.content.content.map(node => node.toJSON());
+
+test('removing several mentions in one transaction preserves intervening and trailing text', () => {
+    const initial = state(mention('a', '图1'), schema.text(' next '), mention('b', '图2'), schema.text(' end'));
+    const transaction = syncReferenceMentions(initial.tr, []);
+    assert.equal(transaction.doc.textContent, ' next  end');
+    assert.equal(transaction.steps.length, 2);
+    assert.equal(initial.doc.firstChild.childCount, 4);
+});
+
+test('deletions before a surviving mention map its relabel position correctly', () => {
+    const initial = state(mention('a', '图1'), schema.text(' / '), mention('b', '图2'), schema.text(' / '), mention('c', '图3'));
+    const transaction = syncReferenceMentions(initial.tr, [asset('c')]);
+    assert.deepEqual(paragraphChildren(transaction), [
+        { type: 'text', text: ' /  / ' },
+        mention('c', '图1').toJSON(),
+    ]);
+});
+
+test('mixed media reorder preserves reference identity and updates labels and source', () => {
+    const initial = state(mention('a', '图1'), mention('b', '图2'), mention('v', '视1', 'video_node'));
+    const transaction = syncReferenceMentions(initial.tr, [asset('b'), { ...asset('a'), src: 'updated.png' }, asset('v', 'video_node')]);
+    assert.deepEqual(paragraphChildren(transaction).map(node => ({ ...node.attrs })), [
+        { id: 'a', label: '图2', src: 'updated.png', mediaType: 'picture' },
+        { id: 'b', label: '图1', src: 'b.png', mediaType: 'picture' },
+        { id: 'v', label: '视1', src: 'v.png', mediaType: 'video_node' },
+    ]);
+});
+
+test('unchanged media does not create a history transaction', () => {
+    const initial = state(schema.text('keep '), mention('a', '图1'));
+    const transaction = syncReferenceMentions(initial.tr, [asset('a')]);
+    assert.equal(transaction.docChanged, false);
+    assert.equal(transaction.steps.length, 0);
+});
diff --git a/frontend/src/components/canvas/generation-panel/utils/panelLayout.js b/frontend/src/components/canvas/generation-panel/utils/panelLayout.js
new file mode 100644
index 0000000..f28e1d7
--- /dev/null
+++ b/frontend/src/components/canvas/generation-panel/utils/panelLayout.js
@@ -0,0 +1,14 @@
+export function getPanelLayout({ anchor, viewportWidth, viewportHeight, panelHeight, preferredWidth = 520, margin = 16 }) {
+    const width = Math.min(preferredWidth, Math.max(1, viewportWidth - margin * 2));
+    const maxHeight = Math.max(1, viewportHeight - margin * 2);
+    const height = Math.min(panelHeight, maxHeight);
+    const below = anchor.top + anchor.height + margin;
+    const above = anchor.top - height - margin;
+    const desiredTop = below + height <= viewportHeight - margin ? below : above;
+    return {
+        width,
+        maxHeight,
+        left: Math.max(margin, Math.min(anchor.left + anchor.width / 2 - width / 2, viewportWidth - width - margin)),
+        top: Math.max(margin, Math.min(desiredTop, viewportHeight - height - margin)),
+    };
+}
