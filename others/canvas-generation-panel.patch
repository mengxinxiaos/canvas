+import { StrictMode, useCallback, useState } from 'react';
+import { createRoot } from 'react-dom/client';
+import GenerationPanel from '../../src/components/canvas/generation-panel/GenerationPanel';
+import '../../src/assets/index.css';
+
+const query = new URLSearchParams(window.location.search);
+const mode = query.get('mode') || 'video';
+const count = Number(query.get('count') ?? 50);
+const mixed = query.get('mixed') !== 'false';
+const svg = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" width="80" height="80"><rect width="80" height="80" fill="#364e70"/><circle cx="40" cy="38" r="20" fill="#6b9ac4"/></svg>')}`;
+const assets = Array.from({ length: count }, (_, index) => ({
+    id: `asset-${index}`,
+    type: !mixed || index < 35 ? 'picture' : index < 45 ? 'video_node' : 'audio',
+    src: query.has('unready') && index === 0 ? undefined : svg,
+}));
+
+export default function Fixture() {
+    const [incoming, setIncoming] = useState(assets);
+    const [open, setOpen] = useState(true);
+    const [submissions, setSubmissions] = useState([]);
+    const [anchor, setAnchor] = useState({
+        id: 'generator', type: mode, position: { x: 460, y: 420 }, size: { w: 280, h: 180 },
+        generation: {
+            model: mode === 'video' ? 'doubao-seedance-2.5' : 'nano-banana-2',
+            prompt: query.get('prompt') ?? (count ? '参考 @图1 与 @图2' : '电影场景'),
+            duration: '30', aspectRatio: '16:9', resolution: '720p', videoRefMode: 'multi_ref',
+            inputs: assets.map(asset => ({ id: asset.id, type: asset.type === 'picture' ? 'image' : asset.type === 'video_node' ? 'video' : 'audio', url: asset.src })),
+            referenceNodeIds: assets.map(asset => asset.id),
+        },
+    });
+    const updateNodeData = useCallback((_id, patch) => setAnchor(previous => ({
+        ...previous, ...patch, generation: { ...previous.generation, ...patch.generation },
+    })), []);
+    const removeConnection = useCallback(id => setIncoming(previous => previous.filter(asset => asset.id !== id)), []);
+    const generate = useCallback(payload => setSubmissions(previous => [...previous, payload]), []);
+    return (
+        <main className="relative w-screen h-screen text-white">
+            <div className="fixed top-0 left-0 z-0 flex flex-wrap gap-2 p-1 text-xs" data-fixture-controls>
+                <button onClick={() => setOpen(value => !value)}>{open ? '关闭面板' : '打开面板'}</button>
+                <button onClick={() => removeConnection('asset-0')}>外部断开第一项</button>
+                <button onClick={() => setIncoming(previous => previous.some(asset => asset.id === 'asset-0') ? previous : [...previous, assets[0]])}>重新连接第一项</button>
+                <button onClick={() => updateNodeData('generator', { generation: { duration: '8', model: 'doubao-seedance-2.5' } })}>外部更新时长</button>
+                <button onClick={() => updateNodeData('generator', { _isLoading: true })}>模拟生成中</button>
+                <button onClick={() => updateNodeData('generator', { generation: {
+                    prompt: '来自协作的新文字 @图3',
+                    referenceNodeIds: [...assets].reverse().map(asset => asset.id),
+                    inputs: [...assets].reverse().map(asset => ({ id: asset.id, type: asset.type === 'picture' ? 'image' : asset.type === 'video_node' ? 'video' : 'audio', url: asset.src })),
+                } })}>外部同时更新文本和顺序</button>
+            </div>
+            {open && <GenerationPanel
+                key={anchor.id} mode={mode} anchorNode={anchor} incomingNodes={incoming.map(asset => ({ ...asset }))}
+                viewport={{ x: 0, y: 0, zoom: 1 }} updateNodeData={updateNodeData}
+                onRemoveConnection={removeConnection} onGenerate={generate}
+            />}
+            <pre hidden data-testid="saved-state">{JSON.stringify(anchor)}</pre>
+            <pre hidden data-testid="submissions">{JSON.stringify(submissions)}</pre>
+        </main>
+    );
+}
